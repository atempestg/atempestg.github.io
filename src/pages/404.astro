---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="요청한 페이지를 찾지 못했습니다.">
  <section class="not-found page-pad">
    <p class="eyebrow">404 / Not found</p>
    <h1>길을 잃은<br /><em>페이지입니다.</em></h1>
    <a class="text-link" href={import.meta.env.BASE_URL}>포트폴리오 홈으로 돌아가기 ↗</a>
  </section>
</BaseLayout>
